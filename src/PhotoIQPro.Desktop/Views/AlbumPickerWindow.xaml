<Window x:Class="PhotoIQPro.Desktop.Views.AlbumPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to Album"
        Width="380" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background"   Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,5"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background"   Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource Surface2Brush}"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Existing albums -->
        <TextBlock Grid.Row="0" Text="Choose an existing album:" FontSize="13"
                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
            <ListBox x:Name="AlbumList"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     SelectionMode="Single"
                     SelectionChanged="AlbumList_SelectionChanged"
                     MouseDoubleClick="AlbumList_DoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF45475A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#FF1E1E2E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Divider -->
        <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Separator Grid.Column="0" VerticalAlignment="Center" Background="{StaticResource Surface2Brush}"/>
            <TextBlock Grid.Column="1" Text="  or create new  " FontSize="11"
                       Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center"/>
            <Separator Grid.Column="2" VerticalAlignment="Center" Background="{StaticResource Surface2Brush}"/>
        </Grid>

        <!-- Create new album section -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Library picker -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Library:" FontSize="12" Foreground="{StaticResource SubtextBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="LibraryCombo" Grid.Column="1"
                          Style="{StaticResource FieldCombo}"
                          SelectionChanged="LibraryCombo_SelectionChanged"/>
            </Grid>

            <!-- New library name (visible only when "New library…" is selected) -->
            <Grid x:Name="NewLibraryRow" Grid.Row="1" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name:" FontSize="12" Foreground="{StaticResource SubtextBrush}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="NewLibraryNameBox" Grid.Column="1"
                         Style="{StaticResource FieldBox}"
                         TextChanged="NewField_TextChanged"/>
            </Grid>

            <!-- Album name -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Album:" FontSize="12" Foreground="{StaticResource SubtextBrush}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="NewAlbumNameBox" Grid.Column="1"
                         Style="{StaticResource FieldBox}"
                         TextChanged="NewField_TextChanged"/>
            </Grid>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Content="Add to Album" Style="{StaticResource Btn}"
                    IsEnabled="False" Click="Add_Click"
                    Background="{StaticResource AccentBrush}" Foreground="#FF1E1E2E" FontWeight="SemiBold"/>
            <Button x:Name="CreateButton" Content="Create &amp; Add" Style="{StaticResource Btn}"
                    IsEnabled="False" Click="Create_Click" Margin="8,0,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="#FF1E1E2E" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
