<Window x:Class="PhotoIQPro.Desktop.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoIQ Pro"
        Width="480" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Border Background="#1a1a1a" CornerRadius="10"
            BorderBrush="#333333" BorderThickness="1">

        <Grid Margin="48,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- App name -->
            <TextBlock Grid.Row="0"
                       Text="📷 PhotoIQ"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <!-- Subtitle -->
            <TextBlock Grid.Row="1"
                       Text="Private AI Photo Intelligence"
                       FontSize="13" Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

            <!-- Status message -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       FontSize="14" Foreground="#cccccc"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>

            <!-- Spinner — visible while checking -->
            <ProgressBar Grid.Row="3"
                         IsIndeterminate="True"
                         Width="160" Height="3"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,16"
                         Foreground="#666666" Background="Transparent" BorderThickness="0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <!-- Error: reinstall note + Continue Anyway button -->
            <StackPanel Grid.Row="4" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Tags and descriptions won't work until the AI engine is available."
                           FontSize="11" Foreground="#666666"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,12"/>
                <Button Content="Continue Without AI"
                        Click="OnContinueAnyway"
                        Padding="20,8"
                        HorizontalAlignment="Center"
                        Foreground="White" Background="#444444" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>
