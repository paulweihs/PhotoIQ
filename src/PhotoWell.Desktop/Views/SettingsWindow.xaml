<Window x:Class="PhotoWell.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoWell.Desktop.Converters"
        Title="Settings"
        Width="620" Height="620"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <SolidColorBrush x:Key="GreenBrush"    Color="#FFA6E3A1"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter    x:Key="InverseBool"/>

        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="{StaticResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="20,10"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Border x:Name="Underline" BorderThickness="0,0,0,2"
                                    BorderBrush="Transparent" Padding="0,0,0,2">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"     Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"     Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="8,6"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="CaretBrush"     Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                                <!-- Placeholder text — shown when TextBox is empty and unfocused -->
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Padding="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"     Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"     Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="14,7"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" BasedOn="{StaticResource Btn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7AA2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,4"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,4"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Dark-themed ComboBox — full ControlTemplate to avoid native white rendering -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="FontSize"   Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2289B4FA"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}"
                                             SelectionBrush="{StaticResource AccentBrush}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             Focusable="True"
                                             VerticalAlignment="Center"
                                             IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 4 4 L 8 0"
                                                          Stroke="{StaticResource SubtextBrush}"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Placement="Bottom">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource Surface2Brush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ══ AI Engine ══════════════════════════════════════════════════ -->
            <TabItem Header="AI Engine">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>

                        <!-- ── CONNECTION ───────────────────────────────────── -->
                        <TextBlock Text="CONNECTION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Ollama Base URL" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OllamaUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                     Tag="e.g. http://localhost:11434"/>
                            <Button Grid.Column="1" Content="Test"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource Btn}" Margin="0,0,10,0"
                                    ToolTip="Test the connection to Ollama at this URL"/>
                            <!-- Connection status — inline with Test button -->
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
                                        <Setter Property="Text"       Value="{Binding ConnectionStatus}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- ── MODELS ────────────────────────────────────────── -->
                        <TextBlock Text="MODELS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>

                        <!-- Vision model -->
                        <TextBlock Text="Vision Model" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                        <TextBlock Text="Populated from Ollama — click Test to refresh"
                                   Style="{StaticResource NoteText}" Margin="0,0,0,6"/>
                        <ComboBox IsEditable="True"
                                  Text="{Binding VisionModel, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AvailableModels}"
                                  Style="{StaticResource DarkComboBox}"
                                  Margin="0,0,0,6"
                                  ToolTip="Select a vision model installed in Ollama, or type a name manually"/>
                        <Border Background="#1AE8A020" BorderBrush="#33E8A020" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CCB870" Margin="0,0,0,6">
                                    <Run FontWeight="SemiBold">Accuracy vs. speed tradeoff:</Run>
                                    <Run>llama3.2-vision is slower but accurate. moondream is fast but invents objects, relationships, and actions more frequently.</Run>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="llama3.2-vision"
                                               FontSize="11" Foreground="#CCB870" FontWeight="SemiBold" Margin="0,0,12,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Foreground="{StaticResource SubtextBrush}"
                                               Text="Slower · best accuracy · lowest hallucination rate" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="moondream"
                                               FontSize="11" Foreground="#CCB870" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="{StaticResource SubtextBrush}"
                                               Text="Fast · lower accuracy · higher hallucination risk"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Image search models path -->
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   ToolTip="Folder containing the CLIP model files used for visual similarity search (Find Related Images)">
                            <Run Text="Image Search Models"/>
                        </TextBlock>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ClipModelsPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                     Tag="Folder containing clip_image_model.onnx and clip_text_model.onnx"/>
                            <Button Grid.Column="1" Content="Browse"
                                    Command="{Binding BrowseClipPathCommand}"
                                    Style="{StaticResource Btn}"
                                    ToolTip="Select the folder containing image search model files"
                                    AutomationProperties.Name="Browse for image search models folder"/>
                        </Grid>

                        <!-- Restart note — amber when a restart-required field has changed -->
                        <Border CornerRadius="4" Padding="12,8" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"    Value="#1A89B4FA"/>
                                    <Setter Property="BorderBrush"   Value="#3389B4FA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                            <Setter Property="Background"   Value="#1AE8A020"/>
                                            <Setter Property="BorderBrush"  Value="#55E8A020"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NoteText}">
                                        <Setter Property="Text"       Value="AI Engine changes (URL, model, image search models) require a restart to take effect."/>
                                        <Setter Property="Foreground" Value="#CC89B4FA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                                <Setter Property="Text"       Value="⚠  Restart required — save your changes and relaunch PhotoWell for this to take effect."/>
                                                <Setter Property="Foreground" Value="#CCB870"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Performance ════════════════════════════════════════════════ -->
            <TabItem Header="Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>

                        <!-- Analysis mode -->
                        <TextBlock Text="ANALYSIS MODE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <RadioButton Content="Standard  —  Full CLIP + AI description (recommended)"
                                     IsChecked="{Binding IsExpressMode, Converter={StaticResource InverseBool}}"/>
                        <RadioButton Content="Express  —  CLIP tags only, no AI description"
                                     IsChecked="{Binding IsExpressMode}" Margin="0,4,0,0"/>
                        <TextBlock Text="Express mode skips the vision model — faster indexing, no descriptions."
                                   Style="{StaticResource NoteText}" Margin="0,6,0,24"/>

                        <!-- Import threads -->
                        <TextBlock Text="IMPORT THREADS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1"
                                    Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                    TickPlacement="BottomRight"
                                    Value="{Binding MaxThreads}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="8" Foreground="{StaticResource SubtextBrush}" FontSize="12"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="Current: " Foreground="{StaticResource SubtextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding MaxThreads}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text=" thread(s)" Foreground="{StaticResource SubtextBrush}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="AI inference (vision model) always uses a single thread regardless of this setting."
                                   Style="{StaticResource NoteText}" Margin="0,4,0,24"/>

                        <!-- Thumbnail quality -->
                        <TextBlock Text="THUMBNAIL QUALITY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <CheckBox Content="High-quality thumbnails (slower generation, sharper previews)"
                                  IsChecked="{Binding HighQualityThumbnails}"/>
                        <TextBlock Text="Applies to new imports. Use Re-generate Thumbnails to update existing photos."
                                   Style="{StaticResource NoteText}" Margin="0,6,0,24"/>

                        <!-- Vision image resolution -->
                        <TextBlock Text="VISION IMAGE RESOLUTION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <RadioButton Content="Fast  —  512 px  (recommended)"
                                     IsChecked="{Binding IsVisionFast}"/>
                        <RadioButton Content="Balanced  —  768 px"
                                     IsChecked="{Binding IsVisionBalanced}" Margin="0,4,0,0"/>
                        <RadioButton Content="Quality  —  1024 px"
                                     IsChecked="{Binding IsVisionQuality}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource NoteText}" Margin="0,6,0,24" TextWrapping="Wrap"
                                   Text="Smaller images process 3–4× faster with minimal description quality loss. The vision model rarely benefits from pixel-level detail."/>

                        <!-- Face detection -->
                        <TextBlock Text="FACE DETECTION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <CheckBox Content="Enable face detection and recognition"
                                  IsChecked="{Binding EnableFaceDetection}"
                                  IsEnabled="{Binding IsExpressMode, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NoteText}">
                                    <Setter Property="Text" Value="Detects faces during import and groups them by person. Requires UltraFace and ArcFace models (~15 MB total, downloaded automatically)."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpressMode}" Value="True">
                                            <Setter Property="Text" Value="Face detection is not available in Express mode."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,6,0,24"/>

                        <!-- Units -->
                        <TextBlock Text="DISTANCE UNITS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <RadioButton Content="Metric  —  metres and kilometres"
                                     IsChecked="{Binding UseImperialUnits, Converter={StaticResource InverseBool}}"/>
                        <RadioButton Content="Imperial  —  feet and miles"
                                     IsChecked="{Binding UseImperialUnits}" Margin="0,4,0,0"/>
                        <TextBlock Text="Controls distance labels in the Find Related Images filter."
                                   Style="{StaticResource NoteText}" Margin="0,6,0,24"/>

                        <!-- Startup -->
                        <TextBlock Text="STARTUP" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <CheckBox Content="Show tips on startup"
                                  IsChecked="{Binding ShowTipsOnStartup}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="A rotating tip is shown each time PhotoWell launches. Uncheck to disable, or use the toast's own 'Don't show tips' option."
                                   Style="{StaticResource NoteText}" Margin="0,0,0,24"/>

                        <!-- Maintenance -->
                        <TextBlock Text="MAINTENANCE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,10"/>
                        <Button Content="Rebuild Search Index"
                                Command="{Binding RebuildSearchIndexCommand}"
                                HorizontalAlignment="Left" Padding="10,5"/>
                        <TextBlock Text="Fixes search returning no results after re-analysis. Closes Settings and rebuilds the keyword index in the background."
                                   Style="{StaticResource NoteText}" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Exclusions ═════════════════════════════════════════════════ -->
            <TabItem Header="Exclusions">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource NoteText}" Margin="0,0,0,10"
                               Text="Folders listed here are skipped during Scan Drives. Changes take effect immediately."/>

                    <!-- Exclusion list -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Exclusions}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TypeLabel}"
                                                       Foreground="{StaticResource SubtextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Width="70" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="×"
                                                    Command="{Binding DataContext.RemoveExclusionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{StaticResource SubtextBrush}" Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand"
                                                    FontSize="14" Padding="6,2" Margin="4,0,0,0"
                                                    ToolTip="Remove">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#ff5555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Add row -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"
                                 Tag="Folder name or full path…"
                                 Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddExclusionCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="+ Add"
                                Command="{Binding AddExclusionCommand}"
                                Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Browse"
                                Command="{Binding BrowseExclusionCommand}"
                                Style="{StaticResource Btn}"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding ExclusionStatusText}"
                               Foreground="#ff5555" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExclusionStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExclusionStatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </TabItem>

            <!-- ══ Stats ══════════════════════════════════════════════════════ -->
            <TabItem Header="Stats">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel DataContext="{Binding Metrics}">

                        <TextBlock Text="Analysis Performance" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PhotoCountText}" FontSize="12"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,20"/>

                        <!-- Live batch status -->
                        <Border Background="#1AA6E3A1" BorderBrush="#33A6E3A1" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BatchStatusText}" FontSize="13" Foreground="#A6E3A1"/>
                        </Border>

                        <!-- No data state -->
                        <StackPanel Visibility="{Binding NoData, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="No analysis data yet." FontSize="13"
                                       Foreground="{StaticResource SubtextBrush}"/>
                            <TextBlock Text="Import and analyze photos to see performance metrics here."
                                       FontSize="12" Foreground="{StaticResource SubtextBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Metrics grid -->
                        <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Avg time / photo"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AvgTimeText}"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Fastest"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FastestText}"
                                       Foreground="#A6E3A1" FontSize="12" Margin="0,5" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Slowest"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SlowestText}"
                                       Foreground="#FAB387" FontSize="12" Margin="0,5" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Total time"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalTimeText}"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Throughput"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PhotosPerMinText}"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Avg tags / photo"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AvgTagsText}"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,5"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Avg description"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,5"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AvgDescLenText}"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,5"/>

                            <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                    Content="Refresh" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource Btn}"
                                    HorizontalAlignment="Left" Padding="20,8" Margin="0,16,0,0"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ External Editors ═══════════════════════════════════════════ -->
            <TabItem Header="External Editors">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource NoteText}" Margin="0,0,0,10"
                               Text="Editors listed here appear in the Send To submenu on every photo's context menu."/>

                    <!-- Editor list -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExternalEditors}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ExePath}"
                                                       Foreground="{StaticResource SubtextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="×"
                                                    Command="{Binding DataContext.RemoveExternalEditorCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{StaticResource SubtextBrush}" Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand"
                                                    FontSize="14" Padding="6,2" Margin="4,0,0,0"
                                                    ToolTip="Remove">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#ff5555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Add row -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewEditorPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Tag="Path to .exe…"
                                     IsReadOnly="True"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Command="{Binding BrowseExternalEditorCommand}"
                                    Style="{StaticResource Btn}"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewEditorName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Tag="Display name…"
                                     Margin="0,0,8,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddExternalEditorCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="+ Add"
                                    Command="{Binding AddExternalEditorCommand}"
                                    Style="{StaticResource Btn}"/>
                        </Grid>
                    </Grid>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="OnClose"/>
            <Button Content="Save"  Style="{StaticResource AccentBtn}" Command="{Binding SaveCommand}" Click="OnSave"
                    ToolTip="Save settings"/>
        </StackPanel>

        <!-- Toast: "Settings saved" — floats bottom-centre for ~2s after Save -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Background="#FF313244" CornerRadius="6" Padding="18,10"
                Visibility="{Binding SavedToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="✓  Settings saved"
                       Foreground="{StaticResource GreenBrush}"
                       FontSize="13" FontWeight="SemiBold"/>
        </Border>

    </Grid>
</Window>
