<Window x:Class="PhotoWell.Desktop.Views.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoWell.Desktop.Converters"
        xmlns:vm="clr-namespace:PhotoWell.Desktop.ViewModels"
        Title="PhotoWell — People"
        Width="1100" Height="720"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4">

    <Window.Resources>
        <conv:PathToImageSourceConverter       x:Key="PathToBitmap"/>
        <BooleanToVisibilityConverter          x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <SolidColorBrush x:Key="RedBrush"      Color="#FFF38BA8"/>

        <!-- Small icon button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="5,3"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Person card border — merge-selection highlight via DataTrigger.
             Defined here (not inline in DataTemplate) so {StaticResource SurfaceBrush}
             is resolved against Window.Resources, not the DataTemplate's ambient context. -->
        <Style x:Key="PersonCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background"   Value="#33EBA0AC"/>
                    <Setter Property="BorderBrush"  Value="#FFEBA0AC"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header bar ═══ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤  People"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13"
                               Foreground="{StaticResource SubtextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Command="{Binding ToggleMergeModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMergeMode}" Value="True">
                                        <Setter Property="Background" Value="#FFEBA0AC"/>
                                        <Setter Property="Foreground" Value="#FF1E1E2E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⊕  Merge People"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMergeMode}" Value="True">
                                            <Setter Property="Text" Value="✖  Cancel Merge"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Content="Close"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ActionBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ People grid ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <Grid>
                <!-- Loading spinner -->
                <ProgressBar IsIndeterminate="True"
                             Width="200" Height="3"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <!-- Empty state message — only shown when not loading and no people found -->
                <TextBlock Text="{Binding StatusText}"
                           FontSize="14"
                           Foreground="{StaticResource SubtextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="40" TextWrapping="Wrap" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding People.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}"    Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Person card grid -->
                <ItemsControl ItemsSource="{Binding People}" Margin="16"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PersonCardViewModel}">
                            <Border Width="150" Margin="8" CornerRadius="8"
                                    Style="{StaticResource PersonCardBorder}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="PersonCard_Click">

                                <StackPanel Margin="12,14,12,10">

                                    <!-- Face avatar — circular crop -->
                                    <Border Width="100" Height="100" CornerRadius="50"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource Surface2Brush}"
                                            ClipToBounds="True" Margin="0,0,0,10">
                                        <Grid>
                                            <!-- Default avatar emoji -->
                                            <TextBlock Text="👤" FontSize="44"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.35"/>
                                            <!-- Actual face crop -->
                                            <Image Source="{Binding KeyFacePath, Converter={StaticResource PathToBitmap}}"
                                                   Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <!-- Display name (read mode) -->
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="126"
                                               ToolTip="{Binding DisplayName}"
                                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>

                                    <!-- Name edit box (edit mode) -->
                                    <TextBox x:Name="NameBox"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource Surface2Brush}"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource AccentBrush}"
                                             BorderThickness="1" FontSize="12"
                                             Padding="5,3" MaxLength="60"
                                             HorizontalAlignment="Center" Width="126"
                                             KeyDown="NameBox_KeyDown" Tag="{Binding}"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Photo count -->
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="11" Margin="0,4,0,8"
                                               Foreground="{StaticResource SubtextBrush}">
                                        <Run Text="{Binding PhotoCount}"/>
                                        <Run Text="photos"/>
                                    </TextBlock>

                                    <!-- Action buttons row -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Rename / confirm / cancel (hidden while editing) -->
                                        <Button ToolTip="Rename"
                                                Style="{StaticResource IconBtn}" Content="✏"
                                                Command="{Binding DataContext.BeginEditCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Button ToolTip="Save name"
                                                Style="{StaticResource IconBtn}" Content="✔"
                                                Foreground="{StaticResource AccentBrush}"
                                                Command="{Binding DataContext.CommitEditCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                        <Button ToolTip="Cancel"
                                                Style="{StaticResource IconBtn}" Content="✖"
                                                Foreground="{StaticResource RedBrush}"
                                                Command="{Binding DataContext.CancelEditCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Favorite star — filled when IsFavorite -->
                                        <Button ToolTip="Pin to top of name suggestions"
                                                Style="{StaticResource IconBtn}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="☆"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text"       Value="★"/>
                                                                <Setter Property="Foreground" Value="#FFFAB387"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Hide (soft — stays in DB) -->
                                        <Button ToolTip="Hide from People list"
                                                Style="{StaticResource IconBtn}" Content="👁"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                Command="{Binding DataContext.HideCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                        <!-- Delete (hard — removes person and unlinks faces) -->
                                        <Button ToolTip="Delete person permanently"
                                                Style="{StaticResource IconBtn}" Content="🗑"
                                                Foreground="{StaticResource RedBrush}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ═══ Merge mode instruction bar ═══ -->
        <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" Padding="24,10"
                Visibility="{Binding IsMergeMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Merge mode: click the avatar of the person to keep, then click the person to absorb into them."
                       FontSize="12" Foreground="{StaticResource SubtextBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
