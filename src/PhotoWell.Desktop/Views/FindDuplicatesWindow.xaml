<Window x:Class="PhotoWell.Desktop.Views.FindDuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Duplicates"
        Width="940" Height="700"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <SolidColorBrush x:Key="GreenBrush"    Color="#FFA6E3A1"/>
        <SolidColorBrush x:Key="RedBrush"       Color="#FFF38BA8"/>
        <SolidColorBrush x:Key="YellowBrush"   Color="#FFF9E2AF"/>
        <SolidColorBrush x:Key="MangosBrush"   Color="#FFFAB387"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource RedBrush}"/>
            <Setter Property="Foreground" Value="#FF1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFF7A93"/>
                    <Setter Property="Foreground" Value="#FF1E1E2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Checkbox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ListBox item style: transparent, no selection highlight, full-width content -->
        <Style x:Key="GroupListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Title ═══ -->
        <TextBlock Grid.Row="0" Text="Find Duplicates"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource TextBrush}" FontSize="13"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ignored-folder indicator — shown when at least one folder is on the ignore list -->
                    <TextBlock Foreground="{StaticResource YellowBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="Some folders are being skipped. Right-click a file card and choose 'Ignore Folder for Duplicate Check' to add more, or click ✕ to clear all.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IgnoredFolderCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding IgnoredFolderCount, Mode=OneWay, StringFormat='{}{0} folder(s) ignored'}"/>
                        <Run Text=" "/>
                        <Hyperlink Click="OnClearIgnoredFoldersClick" Foreground="{StaticResource YellowBrush}">
                            <Run Text="✕ clear"/>
                        </Hyperlink>
                    </TextBlock>
                    <!-- Marked-files summary -->
                    <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasMarked, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding MarkedCount, Mode=OneWay}"/>
                        <Run Text=" files marked · "/>
                        <Run Text="{Binding MarkedSizeText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Empty state ═══ -->
        <Border Grid.Row="2"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{StaticResource GreenBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="No duplicates found in your library."
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Run Scan again after importing new photos."
                           FontSize="12" Foreground="{StaticResource SubtextBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!--
            ═══ Groups list ═══
            Uses a ListBox with VirtualizingStackPanel so only visible groups are
            in the visual tree. This prevents the resize-lag caused by having hundreds
            of WrapPanel items all doing layout simultaneously when the window width
            changes. VirtualizationMode=Recycling reuses containers rather than
            recreating them on scroll. ScrollUnit=Pixel gives smooth pixel scrolling
            even though CanContentScroll=True is required for virtualization.
        -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Groups}"
                 ItemContainerStyle="{StaticResource GroupListBoxItem}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0"
                 Focusable="False"
                 Padding="0,0,4,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Group card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="6" Margin="0,0,0,12" Padding="14,12">
                        <StackPanel>

                            <!-- Group header -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Type badge -->
                                <Border Grid.Column="0" CornerRadius="3" Padding="7,3" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="RawJpegPair">
                                                    <Setter Property="Background" Value="{StaticResource MangosBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="PerceptualSimilar">
                                                    <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TypeLabel}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#FF1E1E2E"/>
                                </Border>

                                <!-- Hint text -->
                                <TextBlock Grid.Column="1" Text="{Binding TypeHint}"
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontSize="12" VerticalAlignment="Center"/>

                                <!-- File count -->
                                <TextBlock Grid.Column="2"
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding Files.Count, Mode=OneWay}"/>
                                    <Run Text=" files"/>
                                </TextBlock>
                            </Grid>

                            <!-- Quick-action row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <!-- RAW/JPG pair actions -->
                                <Button Content="Keep RAW" Command="{Binding KeepRawCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Visibility="{Binding IsRawJpegPair, Converter={StaticResource BoolToVis}}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Mark all JPG files for deletion, keep the RAW original"/>
                                <Button Content="Keep JPG" Command="{Binding KeepJpgCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Visibility="{Binding IsRawJpegPair, Converter={StaticResource BoolToVis}}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Mark all RAW files for deletion, keep the JPG"/>
                                <!-- Exact-copy and near-duplicate actions -->
                                <Button Content="Keep Newest" Command="{Binding KeepNewestCommand}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Mark all but the most recently dated file for deletion">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExactHash}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPerceptualSimilar}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Keep Oldest" Command="{Binding KeepOldestCommand}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Mark all but the oldest file for deletion">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExactHash}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPerceptualSimilar}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Always-visible clear -->
                                <Button Content="Clear" Command="{Binding ClearMarksCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Padding="10,4" FontSize="11"
                                        ToolTip="Clear all deletion marks in this group"/>
                            </StackPanel>

                            <!-- File cards -->
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            Tag = FindDuplicatesViewModel (the Window's DataContext).
                                            ContextMenu is outside the visual tree so it can't use
                                            RelativeSource to reach the VM directly; we ferry it via Tag
                                            so the ContextMenu can bind its DataContext to PlacementTarget.Tag.
                                        -->
                                        <Border Width="160" Margin="0,0,8,8"
                                                CornerRadius="4" Padding="0,0,0,8"
                                                Background="{StaticResource Surface2Brush}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <!-- DataContext = FindDuplicatesViewModel (via PlacementTarget.Tag).
                                                     CommandParameter = DuplicateFileViewModel (PlacementTarget.DataContext). -->
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Open Folder in Explorer"
                                                              Command="{Binding OpenFileInExplorerCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Copy Full Path"
                                                              Command="{Binding CopyFilePathCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Re-analyze with AI" IsEnabled="False"/>
                                                    <MenuItem Header="Find similar photos" IsEnabled="False"/>
                                                    <Separator/>
                                                    <MenuItem Header="Exclude this photo"
                                                              Command="{Binding ExcludePhotoCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Exclude this folder…"
                                                              Command="{Binding ExcludeFolderCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Ignore Folder for Duplicate Check"
                                                              Command="{Binding IgnoreFolderForDuplicateCheckCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              ToolTip="Hide all duplicate groups where every file is in this folder. Persisted across sessions. Useful for folders with intentional RAW+JPEG pairs."/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <!-- Thumbnail -->
                                                <Border Height="120" CornerRadius="4,4,0,0"
                                                        Background="#FF1E1E2E" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding File.ThumbnailMedium}"
                                                               Stretch="UniformToFill"/>
                                                        <!-- Extension badge — orange for RAW, green for JPG, blue otherwise -->
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                Background="#CC1E1E2E" CornerRadius="0,4,0,3"
                                                                Padding="5,2">
                                                            <TextBlock Text="{Binding ExtBadge}"
                                                                       FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRawBadge}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource MangosBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsJpgBadge}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- File info -->
                                                <StackPanel Margin="8,6,8,0">
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding File.FilePath}"/>
                                                    <TextBlock Text="{Binding FolderPath}"
                                                               Foreground="{StaticResource SubtextBrush}"
                                                               FontSize="10" TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"
                                                               ToolTip="{Binding FolderPath}"/>
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   Foreground="{StaticResource SubtextBrush}"
                                                                   FontSize="10"/>
                                                        <TextBlock Text="{Binding DateText}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource SubtextBrush}"
                                                                   FontSize="10"/>
                                                    </Grid>
                                                    <CheckBox Content="Mark for deletion" IsChecked="{Binding IsMarkedForDeletion}"
                                                              Foreground="{StaticResource RedBrush}"
                                                              FontSize="11" Margin="0,6,0,0"
                                                              ToolTip="Check to include this file when Delete is clicked"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ═══ Bottom buttons ═══ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Scan button -->
            <Button Grid.Column="0" Content="🔍 Scan for Duplicates"
                    Command="{Binding ScanCommand}"
                    Style="{StaticResource ActionButton}"
                    ToolTip="Search the library for exact copies and RAW+JPG pairs"/>

            <!-- Delete + Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteMarkedCommand}"
                        Margin="0,0,8,0" Padding="16,8"
                        ToolTip="Permanently delete all checked files from disk — this cannot be undone">
                    <TextBlock>
                        <Run Text="🗑 Delete "/>
                        <Run Text="{Binding MarkedCount, Mode=OneWay}"/>
                        <Run Text=" files ("/>
                        <Run Text="{Binding MarkedSizeText, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </Button>
                <Button Content="Close" Click="OnCloseClick"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
