<Window x:Class="PhotoWell.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Width="380" Height="180"
        Background="#1E1E2E"
        AllowsTransparency="False">

    <Border BorderBrush="#313244" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">

            <!-- App name -->
            <TextBlock Text="PhotoWell"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="#FFCDD6F4"
                       HorizontalAlignment="Center"/>

            <!-- Version -->
            <TextBlock x:Name="VersionText"
                       FontSize="12"
                       Foreground="#FFA6ADC8"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,24"/>

            <!-- Indeterminate spinner — shown during init phases -->
            <ProgressBar x:Name="IndeterminateBar"
                         IsIndeterminate="True"
                         Height="3"
                         Foreground="#FF89B4FA"
                         Background="#FF313244"
                         BorderThickness="0"/>

            <!-- Determinate bar — shown only during model download -->
            <ProgressBar x:Name="DownloadBar"
                         Height="3"
                         Foreground="#FFA6E3A1"
                         Background="#FF313244"
                         BorderThickness="0"
                         Visibility="Collapsed"
                         Minimum="0" Maximum="1"/>

            <!-- Status caption -->
            <TextBlock x:Name="StatusText"
                       Text="Starting up…"
                       FontSize="11"
                       Foreground="#FFA6ADC8"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
