<Window x:Class="PhotoWell.Desktop.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoWell.Desktop.Converters"
        Title="Backup &amp; Export"
        Width="620" Height="560"
        MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <SolidColorBrush x:Key="GreenBrush"    Color="#FFA6E3A1"/>
        <SolidColorBrush x:Key="RedBrush"      Color="#FFF38BA8"/>

        <BooleanToVisibilityConverter          x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:InverseBoolConverter             x:Key="InverseBool"/>

        <!-- Shared action button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BrowseBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding"  Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"    Value="0,6,0,0"/>
        </Style>

        <Style x:Key="ProgressBar" TargetType="ProgressBar">
            <Setter Property="Height"          Value="5"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin"          Value="0,6,0,0"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background"    Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"    Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="8,5"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="IsReadOnly"    Value="True"/>
            <Setter Property="CaretBrush"    Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,14">
            <TextBlock Text="Backup &amp; Export" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
        </Border>

        <!-- Tab control -->
        <TabControl Grid.Row="1" Background="#FF1E1E2E" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"     Value="Transparent"/>
                    <Setter Property="Foreground"     Value="{StaticResource SubtextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"        Value="16,8"/>
                    <Setter Property="FontSize"       Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- TAB: Backup                                                   -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="Create Library Backup"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,16">
                            Saves a ZIP of your library database — all descriptions, tags, faces, ratings, and
                            captions. The original photo files are not copied (they remain on disk at their
                            current location). Thumbnails can optionally be included to avoid regeneration on restore.
                        </TextBlock>

                        <!-- Include thumbnails -->
                        <CheckBox IsChecked="{Binding IncludeThumbnails}"
                                  Foreground="{StaticResource TextBrush}" FontSize="12"
                                  Margin="0,0,0,4">
                            Include thumbnails
                        </CheckBox>
                        <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="20,0,0,16">
                            <Run Text="Estimated size: "/>
                            <Run Text="{Binding BackupSizeEstimate}" FontWeight="SemiBold"
                                 Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>

                        <!-- Action -->
                        <Button Content="Choose Destination &amp; Backup…"
                                Style="{StaticResource AccentBtn}"
                                HorizontalAlignment="Left"
                                Command="{Binding BackupAsyncCommand}"
                                IsEnabled="{Binding IsBackupRunning, Converter={StaticResource InverseBool}}"/>

                        <!-- Progress -->
                        <ProgressBar Value="{Binding BackupProgress}" Maximum="100"
                                     Style="{StaticResource ProgressBar}"
                                     Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource StatusText}"/>
                        <TextBlock Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding BackupDone, Converter={StaticResource BoolToVis}}"
                                   Text="✓ Backup complete"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- TAB: Restore                                                  -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Restore">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="Restore from Backup"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,16">
                            Replaces your current library database with a previously saved backup.
                            Any changes made after the backup was created will be lost. The gallery
                            will reload automatically when restore completes.
                        </TextBlock>

                        <TextBlock Text="Backup file" Style="{StaticResource Label}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FieldBox}"
                                     Text="{Binding RestoreFilePath}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Style="{StaticResource BrowseBtn}"
                                    Command="{Binding BrowseRestoreFileCommand}"/>
                        </Grid>

                        <Button Content="Restore Library…"
                                Style="{StaticResource AccentBtn}"
                                HorizontalAlignment="Left"
                                Command="{Binding RestoreAsyncCommand}"
                                IsEnabled="{Binding IsRestoreRunning, Converter={StaticResource InverseBool}}"/>

                        <ProgressBar Value="{Binding RestoreProgress}" Maximum="100"
                                     Style="{StaticResource ProgressBar}"
                                     Visibility="{Binding IsRestoreRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding RestoreStatus}" Style="{StaticResource StatusText}"/>
                        <TextBlock Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding RestoreDone, Converter={StaticResource BoolToVis}}"
                                   Text="✓ Restore complete — library reloaded"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- TAB: Export Bundle                                             -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="Export Selected Photos"/>

                        <!-- No-selection notice -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                                Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="12"
                                       Foreground="{StaticResource SubtextBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Selection info -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                                Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="12"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,16">
                            Creates a <Bold>.pwbundle</Bold> file containing the original photo files plus all
                            metadata (descriptions, tags, ratings, captions, face names). The recipient can
                            import the bundle into their own PhotoWell library.
                        </TextBlock>

                        <Button Content="Choose Destination &amp; Export…"
                                Style="{StaticResource AccentBtn}"
                                HorizontalAlignment="Left"
                                Command="{Binding ExportAsyncCommand}"
                                IsEnabled="{Binding HasSelection}"/>

                        <ProgressBar Value="{Binding ExportProgress}" Maximum="100"
                                     Style="{StaticResource ProgressBar}"
                                     Visibility="{Binding IsExportRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource StatusText}"/>
                        <TextBlock Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding ExportDone, Converter={StaticResource BoolToVis}}"
                                   Text="✓ Export complete"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- TAB: Import Bundle                                             -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Import">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHead}" Text="Import from Bundle"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,16">
                            Opens a <Bold>.pwbundle</Bold> file and adds its photos to your library.
                            Photos already in your library are compared and you'll be prompted to resolve
                            any differences. New photos are added without re-running AI analysis.
                        </TextBlock>

                        <!-- Bundle file -->
                        <TextBlock Text="Bundle file" Style="{StaticResource Label}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FieldBox}"
                                     Text="{Binding BundleFilePath}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Style="{StaticResource BrowseBtn}"
                                    Command="{Binding BrowseBundleFileCommand}"/>
                        </Grid>

                        <!-- Bundle summary -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                                Padding="10,8" Margin="0,0,0,16"
                                Visibility="{Binding HasBundleSummary, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BundleSummary}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <!-- Destination folder -->
                        <TextBlock Text="Extract photos to" Style="{StaticResource Label}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FieldBox}"
                                     Text="{Binding BundleDestFolder}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Style="{StaticResource BrowseBtn}"
                                    Command="{Binding BrowseBundleDestFolderCommand}"/>
                        </Grid>

                        <Button Content="Import Bundle…"
                                Style="{StaticResource AccentBtn}"
                                HorizontalAlignment="Left"
                                Command="{Binding ImportBundleAsyncCommand}"
                                IsEnabled="{Binding IsBundleImportRunning, Converter={StaticResource InverseBool}}"/>

                        <ProgressBar Value="{Binding BundleImportProgress}" Maximum="100"
                                     Style="{StaticResource ProgressBar}"
                                     Visibility="{Binding IsBundleImportRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding BundleImportStatus}" Style="{StaticResource StatusText}"/>
                        <TextBlock Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding BundleImportDone, Converter={StaticResource BoolToVis}}"
                                   Text="✓ Import complete — gallery refreshed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
