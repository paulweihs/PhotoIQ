<Window x:Class="PhotoWell.Desktop.Views.FaceReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm faces"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Border Padding="20" Background="#FF1E1E2E">
        <StackPanel>
        <!-- Header with counter -->
        <TextBlock x:Name="HeaderText"
                   Text="Is this [person]?"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#FFCDD6F4"
                   Margin="0,0,0,12"/>
        <TextBlock x:Name="CounterText"
                   Text="1 / 5"
                   FontSize="11" Foreground="#FF888888"
                   Margin="0,0,0,12"/>

        <!-- Main content panel (face + photo) -->
        <Grid x:Name="MainPanel"
              Visibility="Visible"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Face crop — large thumbnail -->
            <Border Grid.Column="0"
                    Background="#FF313244"
                    BorderBrush="#FF45475A" BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Image x:Name="FaceCropImage"
                       Stretch="UniformToFill"/>
            </Border>

            <!-- Spacer -->
            <TextBlock Grid.Column="1"/>

            <!-- Photo thumbnail — context -->
            <Border Grid.Column="2"
                    Background="#FF313244"
                    BorderBrush="#FF45475A" BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Image x:Name="PhotoThumbImage"
                       Stretch="UniformToFill"/>
            </Border>
        </Grid>

        <!-- Done state panel -->
        <StackPanel x:Name="DonePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <TextBlock x:Name="DoneText"
                       Text="Done! Confirmed X photos."
                       FontSize="12" Foreground="#FFCDD6F4"
                       TextAlignment="Center"
                       Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0">
            <!-- Yes button (only shown during review) -->
            <Button x:Name="YesBtn"
                    Content="Yes"
                    Click="YesBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"/>

            <!-- No button (only shown during review) -->
            <Button x:Name="NoBtn"
                    Content="No"
                    Click="NoBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"/>

            <!-- Skip button (only shown during review) -->
            <Button x:Name="SkipBtn"
                    Content="Skip"
                    Click="SkipBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"/>

            <!-- Never ask button (only shown during review) -->
            <Button x:Name="NeverAskBtn"
                    Click="NeverAskBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"
                    ToolTip="Stop asking about this person — all face matches will be accepted automatically"/>

            <!-- Close button (only shown when done) -->
            <Button x:Name="CloseBtn"
                    Content="Done"
                    Click="CloseBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Visibility="Collapsed"/>
        </StackPanel>
        </StackPanel>
    </Border>
</Window>
