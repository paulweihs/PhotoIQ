<Window x:Class="PhotoWell.Desktop.Views.FaceReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review AI matches"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#FF1E1E2E">
        <StackPanel>
        <!-- Context explanation — always visible -->
        <TextBlock x:Name="SubtitleText"
                   FontSize="11" Foreground="#FF888888"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <!-- Per-face question -->
        <TextBlock x:Name="HeaderText"
                   Text="Is this [person]?"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#FFCDD6F4"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="CounterText"
                   Text="1 / 5"
                   FontSize="11" Foreground="#FF888888"
                   Margin="0,0,0,12"/>

        <!-- Main content panel (face + photo) -->
        <Grid x:Name="MainPanel"
              Visibility="Visible"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Face crop — large thumbnail -->
            <Border Grid.Column="0"
                    Background="#FF313244"
                    BorderBrush="#FF45475A" BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Image x:Name="FaceCropImage"
                       Stretch="UniformToFill"/>
            </Border>

            <!-- Spacer -->
            <TextBlock Grid.Column="1"/>

            <!-- Photo thumbnail — context (different photo) -->
            <StackPanel Grid.Column="2">
                <Border Background="#FF313244"
                        BorderBrush="#FF45475A" BorderThickness="1"
                        CornerRadius="4" ClipToBounds="True">
                    <Image x:Name="PhotoThumbImage"
                           Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="PhotoFilenameText"
                           FontSize="10" Foreground="#FF888888"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Done state panel -->
        <StackPanel x:Name="DonePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <TextBlock x:Name="DoneText"
                       Text="Done! Confirmed X photos."
                       FontSize="12" Foreground="#FFCDD6F4"
                       TextAlignment="Center"
                       Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0">
            <!-- Yes button (only shown during review) -->
            <Button x:Name="YesBtn"
                    Content="Yes"
                    Click="YesBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"/>

            <!-- No button (only shown during review) -->
            <Button x:Name="NoBtn"
                    Content="No"
                    Click="NoBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"/>

            <!-- Skip button (only shown during review) -->
            <Button x:Name="SkipBtn"
                    Content="Skip"
                    Click="SkipBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"/>

            <!-- Never ask button (only shown during review) -->
            <Button x:Name="NeverAskBtn"
                    Click="NeverAskBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Margin="0,0,6,0"
                    Visibility="{Binding ElementName=MainPanel, Path=Visibility}"
                    ToolTip="Stop asking about this person — all face matches will be accepted automatically"/>

            <!-- Close button (only shown when done) -->
            <Button x:Name="CloseBtn"
                    Content="Done"
                    Click="CloseBtn_Click"
                    Style="{StaticResource ActionBtn}"
                    Padding="14,8" FontSize="12"
                    Visibility="Collapsed"/>
        </StackPanel>
        </StackPanel>
    </Border>
</Window>
