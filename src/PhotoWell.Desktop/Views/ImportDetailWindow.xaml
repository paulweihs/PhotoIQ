<Window x:Class="PhotoWell.Desktop.Views.ImportDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Progress"
        Width="264"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- Heading -->
        <TextBlock Text="{Binding Heading}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Thumbnail area — 200×200, dark fill when no image loaded yet -->
        <Border Width="200" Height="200"
                Background="#FF181825"
                HorizontalAlignment="Center"
                Margin="0,0,0,10">
            <Image Source="{Binding CurrentThumbnail}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasCurrentThumbnail, Converter={StaticResource BoolToVis}}"/>
        </Border>

        <!-- Progress bar -->
        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                     Maximum="100"
                     Height="4"
                     Margin="0,0,0,6"/>

        <!-- Status line (X of Y · imported · skipped) -->
        <TextBlock Text="{Binding StatusLine}"
                   FontSize="10"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,8"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Path display: dir part trims with ellipsis, filename always shown -->
        <DockPanel Margin="0,0,0,8"
                   Visibility="{Binding HasCurrentThumbnail, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding CurrentFileNameDisplay}"
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentDirDisplay}"
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Always show thumbnail toggle -->
        <CheckBox Content="Always show thumbnail"
                  IsChecked="{Binding AlwaysShowThumbnail}"
                  FontSize="9"
                  Foreground="{DynamicResource SecondaryTextBrush}"
                  ToolTip="Always wait to decode the thumbnail — may slow import on large files or slow drives."/>

    </StackPanel>
</Window>
