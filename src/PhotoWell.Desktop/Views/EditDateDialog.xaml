<Window x:Class="PhotoWell.Desktop.Views.EditDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Date &amp; Time"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Date" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <DatePicker x:Name="DatePicker" Grid.Column="1"
                        SelectedDateFormat="Short"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"/>
        </Grid>

        <!-- Time -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Time" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBox x:Name="TimeBox" Grid.Column="1"
                     Text="00:00:00"
                     MaxLength="8"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Padding="6,4"
                     ToolTip="Format: HH:MM:SS (24-hour)"/>
        </Grid>

        <!-- Write to file -->
        <CheckBox x:Name="WriteToFileCheck" Grid.Row="2" Margin="0,0,0,6"
                  Content="Also write to original file"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Checked="OnWriteToFileChanged" Unchecked="OnWriteToFileChanged"/>

        <!-- Backup -->
        <CheckBox x:Name="BackupCheck" Grid.Row="3" Margin="20,0,0,16"
                  Content="Keep a backup (.bak) first"
                  IsChecked="True" IsEnabled="False"
                  Foreground="{DynamicResource SecondaryTextBrush}"/>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,0,0,16"
                   FontSize="11" Foreground="#F5A623"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveBtn" Content="Save" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSave"
                    Background="#0078d4" Foreground="White" BorderThickness="0"
                    Padding="0,6" Cursor="Hand"/>
            <Button Content="Cancel" Width="80"
                    IsCancel="True" Click="OnCancel"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    BorderThickness="0" Padding="0,6" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
