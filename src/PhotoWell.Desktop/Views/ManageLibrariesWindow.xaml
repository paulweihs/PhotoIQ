<Window x:Class="PhotoWell.Desktop.Views.ManageLibrariesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoWell.Desktop.ViewModels"
        Title="Manage Libraries"
        Width="560" Height="540"
        MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView item container — remove default selection chrome -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" Focusable="False"
                                                  Background="Transparent" BorderThickness="0"
                                                  Foreground="{StaticResource SubtextBrush}"
                                                  FontSize="9">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <TextBlock x:Name="Arrow" Text="▶" VerticalAlignment="Center"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="20,0,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF313244"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Library" Command="{Binding NewLibraryCommand}"
                    Style="{StaticResource Btn}" Margin="0,0,6,0"/>
            <Button Content="+ Album" Command="{Binding NewAlbumCommand}"
                    IsEnabled="{Binding CanCreateAlbum}"
                    Style="{StaticResource Btn}" Margin="0,0,6,0"/>
            <Button Content="Rename" Command="{Binding RenameCommand}"
                    IsEnabled="{Binding CanDeleteOrRename}"
                    Style="{StaticResource Btn}" Margin="0,0,6,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanDeleteOrRename}"
                    Style="{StaticResource Btn}" Margin="0,0,6,0"/>
            <Button Content="View in Gallery" Command="{Binding ViewInGalleryCommand}"
                    IsEnabled="{Binding IsAlbumSelected}"
                    Style="{StaticResource Btn}"
                    Background="#FF89B4FA" Foreground="#FF1E1E2E" FontWeight="SemiBold"
                    Visibility="{Binding IsAlbumSelected, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Tree -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
            <TreeView Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding Nodes}"
                      SelectedItemChanged="Tree_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Library icon or album icon -->
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="📁"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibrary}" Value="False">
                                                <Setter Property="Text" Value="🖼"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <!-- Photo count badge — only on album nodes -->
                            <Border Grid.Column="2" Background="#FF45475A" CornerRadius="10"
                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsLibrary, Converter={StaticResource BoolToVis},
                                                         ConverterParameter=invert}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibrary}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PhotoCount}" FontSize="11"
                                           Foreground="{StaticResource SubtextBrush}"/>
                            </Border>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasNoLibraries, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="📁" FontSize="40" HorizontalAlignment="Center"/>
            <TextBlock Text="No libraries yet" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="Click + Library to create your first library"
                       Foreground="{StaticResource SubtextBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Margin="0,10,0,0"
                   Foreground="{StaticResource SubtextBrush}" FontSize="12"
                   Text="Photos are never moved or deleted when editing libraries."/>
    </Grid>
</Window>
