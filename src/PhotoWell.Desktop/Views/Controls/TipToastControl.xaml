<UserControl x:Class="PhotoWell.Desktop.Views.Controls.TipToastControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoWell.Desktop.ViewModels"
             Width="340"
             d:DataContext="{d:DesignInstance vm:TipToastViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Entrance: fade in + slide up from +12px, 450ms CubicEaseOut -->
        <Storyboard x:Key="ShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                             Storyboard.TargetProperty="Y"
                             From="12" To="0"
                             Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Exit: fade out + scale to 0.94, 300ms -->
        <Storyboard x:Key="HideStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.94" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.94" Duration="0:0:0.3"/>
        </Storyboard>

    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="#1a1a18"
            CornerRadius="14"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            Opacity="0"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- ── Content ── -->
            <StackPanel Margin="16,12,16,14">

                <!-- Header row: icon square + label + close -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon square -->
                    <Border Grid.Column="0"
                            Width="28" Height="28" CornerRadius="6"
                            Background="#2B4A3F"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentTip.Icon}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- "PHOTOWELL TIP" label -->
                    <TextBlock Grid.Column="1"
                               Text="PHOTOWELL TIP"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#60FFFFFF"
                               FontFamily="DM Sans, Segoe UI, sans-serif"
                               VerticalAlignment="Center"/>

                    <!-- Close button -->
                    <Button Grid.Column="2"
                            Command="{Binding DismissCommand}"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground"      Value="#60FFFFFF"/>
                                <Setter Property="FontSize"        Value="16"/>
                                <Setter Property="Padding"         Value="4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="×"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Padding="{TemplateBinding Padding}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Tip title -->
                <TextBlock Text="{Binding CurrentTip.Title}"
                           FontSize="17" FontWeight="Light"
                           Foreground="#EEEEE8"
                           FontFamily="Cormorant Garamond, Georgia, serif"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           Margin="0,0,0,6"/>

                <!-- Tip subtitle -->
                <TextBlock Text="{Binding CurrentTip.Subtitle}"
                           FontSize="12"
                           Foreground="#80FFFFFF"
                           FontFamily="DM Sans, Segoe UI, sans-serif"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,0,0,12"/>

                <!-- Footer: checkbox + Next tip + Got it -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- "Don't show tips on startup" checkbox -->
                    <CheckBox x:Name="DisableTipsCheckBox"
                              Grid.Column="0"
                              Content="Don't show tips on startup"
                              VerticalAlignment="Center"
                              Checked="OnDisableTipsChecked">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="#60FFFFFF"/>
                                <Setter Property="FontSize"   Value="11"/>
                                <Setter Property="FontFamily" Value="DM Sans, Segoe UI, sans-serif"/>
                                <Setter Property="Cursor"     Value="Hand"/>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- Next tip + Got it buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <!-- Next tip pill -->
                        <Button Content="Next tip"
                                Command="{Binding NextTipCommand}"
                                Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="#2a2a27"/>
                                    <Setter Property="Foreground"      Value="#AAFFFFFF"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="FontFamily"      Value="DM Sans, Segoe UI, sans-serif"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor"          Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="12"
                                                        Padding="12,5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#363633"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Got it pill (teal) -->
                        <Button Content="Got it"
                                Command="{Binding DismissCommand}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="#2B4A3F"/>
                                    <Setter Property="Foreground"      Value="White"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="FontFamily"      Value="DM Sans, Segoe UI, sans-serif"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor"          Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="12"
                                                        Padding="14,5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3a6357"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
