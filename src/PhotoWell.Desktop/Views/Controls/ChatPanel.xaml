<UserControl x:Class="PhotoWell.Desktop.Views.Controls.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoWell.Desktop.ViewModels"
             xmlns:local="clr-namespace:PhotoWell.Desktop.Views.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ChatHeaderButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="#8080A8"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Padding"      Value="6,2"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- User bubble -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background"       Value="#3A3A5C"/>
            <Setter Property="CornerRadius"     Value="12,12,2,12"/>
            <Setter Property="Padding"          Value="10,6"/>
            <Setter Property="MaxWidth"         Value="320"/>
            <Setter Property="Margin"           Value="60,2,4,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Assistant bubble -->
        <Style x:Key="AssistantBubble" TargetType="Border">
            <Setter Property="Background"       Value="#252538"/>
            <Setter Property="CornerRadius"     Value="12,12,12,2"/>
            <Setter Property="Padding"          Value="10,6"/>
            <Setter Property="MaxWidth"         Value="340"/>
            <Setter Property="Margin"           Value="4,2,60,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <Border Style="{StaticResource UserBubble}">
                <TextBlock Text="{Binding Text}" Foreground="#E0E0FF" TextWrapping="Wrap" FontSize="13"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <Border Style="{StaticResource AssistantBubble}">
                <TextBlock Text="{Binding Text}" Foreground="#C8C8E8" TextWrapping="Wrap" FontSize="13"/>
            </Border>
        </DataTemplate>

        <local:ChatMessageTemplateSelector x:Key="MessageSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}"/>
    </UserControl.Resources>

    <Border Background="#1C1C2E" BorderBrush="#3A3A5C" BorderThickness="0,1,0,0"
            Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVis}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80" MaxHeight="300"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Grid Grid.Row="0" Background="#22223A" Height="30">
                <TextBlock Text="AI Assistant" VerticalAlignment="Center" Margin="10,0"
                           Foreground="#A0A0C8" FontSize="12" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <Button Content="Clear" Style="{StaticResource ChatHeaderButton}"
                            Command="{Binding ClearHistoryCommand}"
                            AutomationProperties.Name="Clear conversation history"
                            ToolTip="Clear conversation history"/>
                    <Button Content="✕" Style="{StaticResource ChatHeaderButton}"
                            Command="{Binding TogglePanelCommand}"
                            AutomationProperties.Name="Close chat panel"
                            ToolTip="Close chat panel"/>
                </StackPanel>
            </Grid>

            <!-- Message list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          x:Name="Scroller" Padding="0,4">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  ItemTemplateSelector="{StaticResource MessageSelector}"/>
                    <!-- Thinking indicator -->
                    <Border Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource AssistantBubble}">
                        <TextBlock Text="{Binding ThinkingText}" Foreground="#7878A8"
                                   FontStyle="Italic" FontSize="12"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Follow-up input -->
            <Grid Grid.Row="2" Margin="8,4,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FollowUpBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Ask the AI assistant"
                         Background="#252538" Foreground="#E0E0FF" BorderBrush="#3A3A5C"
                         CaretBrush="#E0E0FF" Padding="8,5" FontSize="13"
                         KeyDown="FollowUpBox_KeyDown"/>
                <Button Grid.Column="1" Content="Send" Margin="6,0,0,0" Padding="14,5"
                        Command="{Binding SendCommand}"
                        AutomationProperties.Name="Send message"
                        Background="#5A2D7A" Foreground="White" BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
