<Window x:Class="PhotoWell.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoWell.Desktop.ViewModels"
        Title="Welcome to Photowell"
        Width="680" Height="600"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="InverseBoolToVisStyle" TargetType="FrameworkElement">
            <!-- Inline inverse visibility via converter defined in code-behind -->
        </Style>

        <!-- ── Dot DataTemplate ──────────────────────────────────────────────
             Active  → 18×6 rounded pill, teal
             Completed → 6×6 circle, teal 35% opacity
             Inactive  → 6×6 circle, cream-dark #EDE8E1
        ──────────────────────────────────────────────────────────────────── -->
        <DataTemplate x:Key="DotTemplate" DataType="{x:Type vm:DotViewModel}">
            <Border x:Name="DotBorder"
                    Width="6" Height="6" CornerRadius="3"
                    Background="#EDE8E1" Margin="0,0,6,0"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.GoToCardCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Index}"/>
                </Border.InputBindings>
            </Border>
            <DataTemplate.Triggers>
                <!-- Active: animate width to 18, colour to teal -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotBorder"
                                                 Storyboard.TargetProperty="Width"
                                                 To="18" Duration="0:0:0.2"/>
                                <ColorAnimation Storyboard.TargetName="DotBorder"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#2B4A3F" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotBorder"
                                                 Storyboard.TargetProperty="Width"
                                                 To="6" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Completed: teal at 35% -->
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="DotBorder" Property="Background"  Value="#2B4A3F"/>
                    <Setter TargetName="DotBorder" Property="Opacity"     Value="0.35"/>
                    <Setter TargetName="DotBorder" Property="Width"       Value="6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             Card visual area templates — one per CardVisualKey enum value.
             DataContext is the CardData record (Content of the ContentControl).
        ══════════════════════════════════════════════════════════════════════ -->

        <!-- Card 1: Welcome -->
        <DataTemplate x:Key="Welcome">
            <Grid>
                <Border Background="#1e342c"/>
                <!-- Gold radial glow -->
                <Border>
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.6" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#18C4974A" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="56" FontWeight="Light"
                               FontFamily="Cormorant Garamond, Georgia, serif">
                        <Run Text="Photo" Foreground="White"/>
                        <Run Text="well"  Foreground="#C4974A"/>
                    </TextBlock>
                    <TextBlock Text="YOUR PHOTOS, UNDERSTOOD."
                               HorizontalAlignment="Center"
                               FontSize="11" Foreground="#66FFFFFF"
                               FontFamily="DM Sans, Segoe UI, sans-serif"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 2: Privacy -->
        <DataTemplate x:Key="Privacy">
            <Grid Background="#0f1a15">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Lock circle -->
                    <Border Width="80" Height="80" CornerRadius="40"
                            Margin="0,0,24,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#2B4A3F" Opacity="0.4"/>
                        </Border.Background>
                        <TextBlock Text="🔒" FontSize="34"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Status rows -->
                    <StackPanel VerticalAlignment="Center" Width="230">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#A6E3A1"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Local AI model"
                                       FontSize="12" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#A6E3A1"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="On-device CLIP embeddings"
                                       FontSize="12" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#A6E3A1"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="SQLite database — your disk only"
                                       FontSize="12" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Opacity="0.4">
                            <Ellipse Width="7" Height="7" Fill="#585858"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif">
                                <Run Text="Cloud upload" TextDecorations="Strikethrough"/>
                                <Run Text=" — blocked"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Opacity="0.4">
                            <Ellipse Width="7" Height="7" Fill="#585858"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif">
                                <Run Text="Telemetry" TextDecorations="Strikethrough"/>
                                <Run Text=" — blocked"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 3: The AI — pipeline diagram -->
        <DataTemplate x:Key="TheAI">
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0c1a14" Offset="0"/>
                            <GradientStop Color="#1a2e22" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Pipeline -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#1a2e22" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Photo"       FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                <TextBlock Text="Your file"   FontSize="9"  Foreground="#50FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Foreground="#2B4A3F" FontSize="20"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <Border Background="#1a2e22" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🧠" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Vision AI"   FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                <TextBlock Text="Local model" FontSize="9"  Foreground="#50FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Foreground="#2B4A3F" FontSize="20"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <Border Background="#1a2e22" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📝" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Description" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                <TextBlock Text="Indexed"     FontSize="9"  Foreground="#50FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Foreground="#2B4A3F" FontSize="20"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <Border Background="#1a2e22" CornerRadius="8" Padding="12,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Searchable"  FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                <TextBlock Text="Instantly"   FontSize="9"  Foreground="#50FFFFFF" HorizontalAlignment="Center"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- Badge -->
                    <Border BorderBrush="#2B4A3F" BorderThickness="1" CornerRadius="12"
                            Padding="12,5" HorizontalAlignment="Center">
                        <TextBlock Text="✦ Runs entirely on your machine"
                                   Foreground="#2B4A3F" FontSize="11"
                                   FontFamily="DM Sans, Segoe UI, sans-serif"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 4: Search — mock search bar + thumbnail grid -->
        <DataTemplate x:Key="Search">
            <Grid Background="#0c1a14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <!-- Mock search bar -->
                    <Border Background="#1a2e22" CornerRadius="8" Padding="12,9" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="16" Foreground="#C4974A"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="golden hour portrait, summer, looking away"
                                       FontSize="13" Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                    <!-- Thumbnail grid 4×2 -->
                    <UniformGrid Rows="2" Columns="4">
                        <!-- Matched (teal border) -->
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#1a2e22"
                                BorderBrush="#2B4A3F" BorderThickness="2">
                            <TextBlock Text="✓" Foreground="#2B4A3F" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,2,3,0" FontWeight="Bold"/>
                        </Border>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#152618"/>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#1a2e22"
                                BorderBrush="#2B4A3F" BorderThickness="2">
                            <TextBlock Text="✓" Foreground="#2B4A3F" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,2,3,0" FontWeight="Bold"/>
                        </Border>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#152618"/>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#152618"/>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#1a2e22"
                                BorderBrush="#C4974A" BorderThickness="2">
                            <TextBlock Text="✓" Foreground="#C4974A" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,2,3,0" FontWeight="Bold"/>
                        </Border>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#152618"/>
                        <Border Margin="3" Height="52" CornerRadius="5" Background="#1a2e22"
                                BorderBrush="#2B4A3F" BorderThickness="2">
                            <TextBlock Text="✓" Foreground="#2B4A3F" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,2,3,0" FontWeight="Bold"/>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 5: Two Search Modes — split panel -->
        <DataTemplate x:Key="TwoModes">
            <Grid Background="#0c1a14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Semantic panel -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20,0">
                    <TextBlock Text="SEMANTIC" FontSize="10" FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               FontFamily="DM Sans, Segoe UI, sans-serif"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="&quot;rainy afternoon, city reflections&quot;"
                               FontSize="12" Foreground="#AAFFFFFF" FontStyle="Italic"
                               FontFamily="Cormorant Garamond, Georgia, serif"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Border Background="#1a2e22" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="mood" FontSize="10" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                        <Border Background="#1a2e22" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="context" FontSize="10" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                        <Border Background="#1a2e22" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="scene" FontSize="10" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                        <Border Background="#1a2e22" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="no tags needed" FontSize="10" Foreground="#80FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <!-- Separator -->
                <Border Grid.Column="1" Background="#33FFFFFF"/>
                <!-- Keyword panel -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20,0">
                    <TextBlock Text="KEYWORD" FontSize="10" FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               FontFamily="DM Sans, Segoe UI, sans-serif"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="&quot;Nikon D850 · 2019 · RAW&quot;"
                               FontSize="12" Foreground="#AAFFFFFF" FontStyle="Italic"
                               FontFamily="Cormorant Garamond, Georgia, serif"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Border Background="#2a1e10" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="filename" FontSize="10" Foreground="#C4974A"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                        <Border Background="#2a1e10" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="camera" FontSize="10" Foreground="#C4974A"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                        <Border Background="#2a1e10" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="date" FontSize="10" Foreground="#C4974A"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                        <Border Background="#2a1e10" CornerRadius="10" Padding="8,3" Margin="3,3">
                            <TextBlock Text="tag" FontSize="10" Foreground="#C4974A"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 6: Favorites & Albums -->
        <DataTemplate x:Key="FavoritesAlbums">
            <Grid Background="#0c1a14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Stacked thumbnail fan -->
                    <Grid Width="90" Height="90" Margin="0,0,28,0" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="6" Background="#1a3326"
                                BorderBrush="#2B4A3F" BorderThickness="1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="6" CenterX="36" CenterY="36"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="72" Height="72" CornerRadius="6" Background="#1e3b2c"
                                BorderBrush="#2B4A3F" BorderThickness="1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="2" CenterX="36" CenterY="36"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="72" Height="72" CornerRadius="6" Background="#253f30"
                                BorderBrush="#3a6357" BorderThickness="1"/>
                    </Grid>
                    <!-- Info rows -->
                    <StackPanel VerticalAlignment="Center" Width="210">
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="⭐" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Favorites" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#DDFFFFFF"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                            <TextBlock Text="Star any photo — instant access"
                                       FontSize="11" Foreground="#70FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Albums" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#DDFFFFFF"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                            <TextBlock Text="Group photos without moving files"
                                       FontSize="11" Foreground="#70FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="🔗" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Non-destructive" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#DDFFFFFF"
                                           FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            </StackPanel>
                            <TextBlock Text="Your folders stay untouched"
                                       FontSize="11" Foreground="#70FFFFFF"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 7: Find Duplicates -->
        <DataTemplate x:Key="FindDuplicates">
            <Grid Background="#0c1a14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <!-- Exact duplicate group -->
                    <Border Background="#131e17" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="EXACT DUPLICATE GROUP" FontSize="9" FontWeight="Bold"
                                       Foreground="#2B4A3F" Margin="0,0,0,8"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="5" Background="#1a2e22" Margin="0,0,6,0"/>
                                <Border Width="56" Height="56" CornerRadius="5" Background="#1a2e22" Margin="0,0,6,0"/>
                                <Border Width="56" Height="56" CornerRadius="5" Background="#1a2e22" Margin="0,0,12,0"/>
                                <Border BorderBrush="#2B4A3F" BorderThickness="1" CornerRadius="12"
                                        Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock Text="Keep newest" FontSize="11" Foreground="#2B4A3F"
                                               FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- RAW + JPEG pair -->
                    <Border Background="#1e1a10" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="RAW + JPEG PAIR" FontSize="9" FontWeight="Bold"
                                       Foreground="#C4974A" Margin="0,0,0,8"
                                       FontFamily="DM Sans, Segoe UI, sans-serif"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="5"
                                        Background="#2a1e10" BorderBrush="#C4974A" BorderThickness="1"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="RAW" FontSize="10" Foreground="#C4974A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                </Border>
                                <Border Width="56" Height="56" CornerRadius="5" Background="#1a2e22"
                                        Margin="0,0,12,0"/>
                                <Border BorderBrush="#C4974A" BorderThickness="1" CornerRadius="12"
                                        Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock Text="Keep RAW" FontSize="11" Foreground="#C4974A"
                                               FontFamily="DM Sans, Segoe UI, sans-serif"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Card 8: Let's Go -->
        <DataTemplate x:Key="LetsGo">
            <Grid>
                <Border Background="#1e342c"/>
                <!-- Gold glow -->
                <Border>
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.45" RadiusY="0.45">
                            <GradientStop Color="#14C4974A" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📂" FontSize="52"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Your photos are waiting."
                               HorizontalAlignment="Center"
                               FontSize="16" FontStyle="Italic"
                               Foreground="#99FFFFFF"
                               FontFamily="Cormorant Garamond, Georgia, serif"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         Outer shadow border — no ClipToBounds so the shadow renders outside.
         Inner content border — ClipToBounds=True for rounded corners.
    ══════════════════════════════════════════════════════════════════════════ -->
    <Border Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <!-- Inner content border — clips children to rounded corners -->
        <Border x:Name="ContentBorder" CornerRadius="12" Background="#F7F3EE" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                    <RowDefinition Height="240"/>  <!-- Visual area -->
                    <RowDefinition Height="*"/>    <!-- Card body -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- ═══ Row 0: Progress bar ═══ -->
                <Grid x:Name="ProgressBarHost" Grid.Row="0">
                    <Border Background="#EDE8E1"/>
                    <Rectangle x:Name="ProgressFill"
                               HorizontalAlignment="Left" Fill="#2B4A3F"
                               Width="0"/>
                </Grid>

                <!-- ═══ Row 1: Visual area (template swapped in code-behind) ═══ -->
                <ContentControl x:Name="VisualArea" Grid.Row="1"
                                MouseLeftButtonDown="OnHeaderMouseDown"
                                Cursor="SizeAll"/>

                <!-- ═══ Row 2: Card body (fades/slides on card change) ═══ -->
                <Grid x:Name="CardBodyGrid" Grid.Row="2" Margin="40,28,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Eyebrow -->
                    <TextBlock x:Name="EyebrowText" Grid.Row="0"
                               FontSize="10" FontWeight="Medium"
                               Foreground="#2B4A3F" Opacity="0.7"
                               FontFamily="DM Sans, Segoe UI, sans-serif"
                               Margin="0,0,0,8"/>

                    <!-- Title — Inlines rebuilt in code-behind for italic runs -->
                    <TextBlock x:Name="TitleText" Grid.Row="1"
                               FontSize="34" FontWeight="Light"
                               Foreground="#1a1a18"
                               FontFamily="Cormorant Garamond, Georgia, serif"
                               TextWrapping="Wrap" LineHeight="40"
                               Margin="0,0,0,14"/>

                    <!-- Body -->
                    <TextBlock x:Name="BodyText" Grid.Row="2"
                               FontSize="15" FontWeight="Light"
                               Foreground="#4a4a45"
                               FontFamily="DM Sans, Segoe UI, sans-serif"
                               TextWrapping="Wrap"
                               LineHeight="25"/>
                </Grid>

                <!-- ═══ Row 3: Footer ═══ -->
                <Grid Grid.Row="3" Margin="40,14,40,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step dots -->
                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding Dots}"
                                  ItemTemplate="{StaticResource DotTemplate}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Skip link — hidden on last card -->
                        <Button x:Name="SkipButton"
                                Content="Skip tutorial"
                                Command="{Binding SkipCommand}"
                                Margin="0,0,20,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontFamily="DM Sans, Segoe UI, sans-serif"
                                Foreground="#7a7a72"
                                Background="Transparent"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"    Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor"        Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontFamily="{TemplateBinding FontFamily}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           TextDecorations="Underline"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastCard}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Continue / Add My First Folder -->
                        <Button x:Name="ContinueButton"
                                Command="{Binding NextCommand}"
                                Cursor="Hand"
                                FontFamily="DM Sans, Segoe UI, sans-serif"
                                FontWeight="Medium">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content"      Value="{Binding ContinueButtonLabel}"/>
                                    <Setter Property="Background"   Value="#2B4A3F"/>
                                    <Setter Property="Foreground"   Value="White"/>
                                    <Setter Property="FontSize"     Value="14"/>
                                    <Setter Property="Padding"      Value="22,10"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor"       Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3a6357"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <!-- Last card: gold background, slightly larger -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastCard}" Value="True">
                                            <Setter Property="Background" Value="#C4974A"/>
                                            <Setter Property="FontSize"   Value="15"/>
                                            <Setter Property="Padding"    Value="26,11"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Border>
</Window>
