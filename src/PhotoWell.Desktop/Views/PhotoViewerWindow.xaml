<Window x:Class="PhotoWell.Desktop.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PhotoWell.Desktop.Converters"
        Title="PhotoWell — Viewer"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#0D0D12"
        Foreground="#FFCDD6F4">

    <Window.Resources>
        <conv:PathToImageSourceConverter       x:Key="PathToBitmap"/>
        <BooleanToVisibilityConverter          x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <SolidColorBrush x:Key="PaneBrush"     Color="#FF1E1E2E"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#FF313244"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF45475A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#FFCDD6F4"/>
        <SolidColorBrush x:Key="SubtextBrush"  Color="#FFA6ADC8"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#FF89B4FA"/>
        <SolidColorBrush x:Key="GreenBrush"    Color="#FFA6E3A1"/>

        <!-- Nav arrow button -->
        <Style x:Key="NavArrow" TargetType="Button">
            <Setter Property="Background" Value="#99000000"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"  Value="52"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC000000"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metadata label (dim) -->
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Metadata value -->
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Selectable read-only text — looks like a TextBlock, supports Ctrl+C -->
        <!-- GotFocus selects all so clicking gives immediate visible highlight feedback -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly"        Value="True"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping"      Value="Wrap"/>
            <Setter Property="IsTabStop"         Value="False"/>
            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
            <Setter Property="SelectionBrush"    Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor"            Value="IBeam"/>
            <EventSetter Event="PreviewMouseDown" Handler="SelectableText_PreviewMouseDown"/>
        </Style>

        <!-- Path variant — NoWrap, scrolls to end on text change so filename is always visible -->
        <Style x:Key="SelectablePathText" BasedOn="{StaticResource SelectableText}" TargetType="TextBox">
            <Setter Property="TextWrapping"  Value="NoWrap"/>
            <EventSetter Event="TextChanged" Handler="PathText_TextChanged"/>
        </Style>

        <!-- Section heading -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Close / action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FF1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Keyboard: ← → Escape Ctrl+0 -->
    <Window.InputBindings>
        <KeyBinding Key="Left"   Command="{Binding PrevCommand}"/>
        <KeyBinding Key="Right"  Command="{Binding NextCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- × close — top-right corner, spans both columns, above all content -->
        <Button Grid.ColumnSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,10,0"
                Command="{Binding CloseCommand}"
                Width="32" Height="32"
                Content="×" FontSize="20"
                Foreground="#FFCDD6F4"
                Cursor="Hand"
                ToolTip="Close (Esc)"
                AutomationProperties.Name="Close viewer"
                Panel.ZIndex="10">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#55000000" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCE53935"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- ═══ Image area ═══ -->
        <Grid Grid.Column="0" Background="#0D0D12"
              MouseWheel="OnImageMouseWheel"
              MouseDown="OnImageMouseDown"
              MouseMove="OnImageMouseMove"
              MouseUp="OnImageMouseUp">
            <Grid.ContextMenu>
                <!-- DataContext = PhotoViewerViewModel; commands are delegated from MainViewModel -->
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Open Folder in Explorer" Command="{Binding OpenInExplorerCommand}"/>
                    <MenuItem Header="Copy Full Path"          Command="{Binding CopyFullPathCommand}"/>
                    <MenuItem Header="Copy to Folder…"        Command="{Binding CopyToFolderCommand}"/>
                    <MenuItem Header="Send To"
                              ItemsSource="{Binding SendToMenuItems}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header"           Value="{Binding Header}"/>
                                <Setter Property="Command"          Value="{Binding Command}"/>
                                <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Separator/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Rotate 90° Clockwise"         Command="{Binding RotateClockwiseCommand}"/>
                    <MenuItem Header="Rotate 90° Counter-Clockwise" Command="{Binding RotateCounterClockwiseCommand}"/>
                    <Separator/>
                    <MenuItem Header="Re-analyze with AI" Command="{Binding ReanalyzeSelectedCommand}"/>
                    <MenuItem Header="Add to Favorites"   Command="{Binding ToggleFavoriteCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exclude this folder" Command="{Binding ExcludeFolderCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exclude this Image" Command="{Binding ExcludeImageCommand}"/>
                    <MenuItem Header="{Binding RemoveFromLibraryLabel}" Command="{Binding RemoveFromLibraryCommand}"/>
                    <MenuItem Header="{Binding DeletePermanentlyLabel}" Command="{Binding DeletePermanentlyCommand}"
                              Foreground="#F38BA8"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- Full-res photo — loaded async in VM to avoid blocking the UI thread.
                 Scroll wheel zooms; Ctrl+0 resets. RenderTransformOrigin centres the scale. -->
            <Image x:Name="ViewerImage"
                   Source="{Binding CurrentImage, TargetNullValue={x:Null}}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale"/>
                        <TranslateTransform x:Name="ImageTranslate"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- Face bounding box overlay — redrawn in code-behind whenever faces load -->
            <Canvas x:Name="FaceOverlayCanvas"
                    IsHitTestVisible="True"
                    Background="Transparent"
                    MouseEnter="FaceOverlay_MouseEnter"
                    MouseLeave="FaceOverlay_MouseLeave"
                    MouseLeftButtonDown="FaceOverlayCanvas_MouseDown"
                    MouseLeftButtonUp="FaceOverlayCanvas_Click"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FaceOverlayScale"/>
                        <TranslateTransform x:Name="FaceOverlayTranslate"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Inline face-naming popup — opened from canvas or sidebar click -->
            <Popup x:Name="FaceNamePopup"
                   StaysOpen="False"
                   AllowsTransparency="False"
                   Placement="MousePoint"
                   PopupAnimation="Slide">
                <Border Background="#EE1E1E2E"
                        BorderBrush="#FF45475A" BorderThickness="1"
                        CornerRadius="8" Padding="14"
                        MinWidth="220">
                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                        <TextBlock x:Name="FacePopupTitle"
                                   Text="Who is this?"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFCDD6F4" Margin="0,0,0,8"/>
                        <!-- AI suggestion chip — shown only when the face is unnamed and a match exists -->
                        <Border x:Name="AiSuggestionBorder"
                                Background="#FF252535"
                                BorderBrush="#FF585B70"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,5"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="AI thinks:"
                                               FontSize="10" Foreground="#FF888888"/>
                                    <TextBlock x:Name="AiSuggestionText"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFA6ADC8"/>
                                </StackPanel>
                                <Button x:Name="AiSuggestionAcceptBtn"
                                        Grid.Column="1"
                                        Content="Accept"
                                        Padding="8,4" FontSize="11"
                                        Style="{StaticResource ActionBtn}"
                                        Click="AiSuggestionAccept_Click"/>
                            </Grid>
                        </Border>
                        <!-- Name input — plain TextBox avoids all ComboBox-in-Popup styling issues -->
                        <TextBox x:Name="FaceNameBox"
                                 Background="#FF313244"
                                 Foreground="#FFCDD6F4"
                                 CaretBrush="#FFCDD6F4"
                                 SelectionBrush="#FF45475A"
                                 BorderBrush="#FF45475A" BorderThickness="1"
                                 Padding="8,5" FontSize="12"
                                 MinWidth="190" MaxLength="60"
                                 PreviewKeyDown="FaceNameBox_PreviewKeyDown"
                                 TextChanged="FaceNameBox_TextChanged"/>
                        <!-- Suggestion list — shown inline below the TextBox when matches exist -->
                        <Border x:Name="SuggestionBorder"
                                Background="#FF313244"
                                BorderBrush="#FF45475A" BorderThickness="1,0,1,1"
                                Visibility="Collapsed"
                                MaxHeight="120">
                            <ListBox x:Name="SuggestionList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFCDD6F4"
                                     IsTabStop="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="SuggestionList_PreviewKeyDown"
                                     PreviewMouseLeftButtonUp="SuggestionList_MouseUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="#FFCDD6F4"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FF45475A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FF89B4FA"/>
                                                            <Setter Property="Foreground" Value="#FF1E1E2E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button x:Name="FaceNameSaveBtn"
                                    Content="Save"
                                    Style="{StaticResource ActionBtn}"
                                    Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                    Click="FaceNameSave_Click"/>
                            <Button x:Name="FaceNameUnlinkBtn"
                                    Content="Unlink"
                                    Style="{StaticResource ActionBtn}"
                                    Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                    Visibility="Collapsed"
                                    Click="FaceNameUnlink_Click"
                                    ToolTip="Remove this face's person assignment"/>
                            <Button Content="Cancel"
                                    Style="{StaticResource ActionBtn}"
                                    Padding="10,5" FontSize="12"
                                    Click="FaceNameCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Loading indicator while image decodes on background thread -->
            <ProgressBar IsIndeterminate="True"
                         Width="160" Height="3"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="#FF89B4FA" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsImageLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Prev arrow — left edge, vertically centred -->
            <Button Command="{Binding PrevCommand}"
                    Style="{StaticResource NavArrow}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Content="&#x2039;"
                    FontSize="38"
                    ToolTip="Previous (←)"
                    AutomationProperties.Name="Previous photo"/>

            <!-- Next arrow — right edge, vertically centred -->
            <Button Command="{Binding NextCommand}"
                    Style="{StaticResource NavArrow}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Content="&#x203A;"
                    FontSize="38"
                    ToolTip="Next (→)"
                    AutomationProperties.Name="Next photo"/>

            <!-- Counter — bottom centre -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Background="#99000000" CornerRadius="20" Padding="14,5"
                    AutomationProperties.Name="{Binding Counter}">
                <TextBlock Text="{Binding Counter}"
                           FontSize="13" Foreground="#CCFFFFFF"/>
            </Border>

            <!-- Debug info — bottom right (face detection status + counts) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,16"
                    Background="#CC1E1E2E" BorderBrush="#FF45475A" BorderThickness="1"
                    CornerRadius="4" Padding="8,4"
                    ToolTip="Face detection status and count">
                <StackPanel>
                    <TextBlock x:Name="DebugStatus"
                               FontSize="10" Foreground="#FF888888"
                               FontFamily="Consolas"/>
                    <TextBlock x:Name="DebugFaceCount"
                               FontSize="10" Foreground="#FF89B4FA"
                               FontFamily="Consolas"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Right pane ═══ -->
        <Border Grid.Column="1" Background="{StaticResource PaneBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scrollable metadata -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,4,0">
                    <StackPanel Margin="24,28,20,16">

                        <!-- File name -->
                        <TextBox Text="{Binding Current.FileName, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"
                                 FontSize="15" FontWeight="SemiBold"
                                 Margin="0,0,0,4"/>

                        <!-- Camera make/model -->
                        <TextBlock Text="{Binding CameraText}"
                                   FontSize="12"
                                   Foreground="{StaticResource SubtextBrush}"
                                   Margin="0,0,0,16"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CameraText}"/>

                        <!-- ── Details ── -->
                        <TextBlock Text="DETAILS" Style="{StaticResource SectionHead}" Margin="0,0,0,8"/>

                        <TextBlock Text="Date" Style="{StaticResource MetaLabel}"/>
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource MetaValue}"/>

                        <TextBlock Text="Dimensions" Style="{StaticResource MetaLabel}"/>
                        <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MetaValue}"/>

                        <TextBlock Text="File size" Style="{StaticResource MetaLabel}"/>
                        <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource MetaValue}"/>

                        <TextBlock Text="Path" Style="{StaticResource MetaLabel}"/>
                        <TextBox Text="{Binding Current.FilePath, Mode=OneWay}"
                                 Style="{StaticResource SelectablePathText}"
                                 FontSize="11"
                                 Margin="0,0,0,12"/>

                        <!-- EXIF line (optional) -->
                        <TextBlock Text="Exposure" Style="{StaticResource MetaLabel}"
                                   Visibility="{Binding HasExif, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ExifLine}" Style="{StaticResource MetaValue}"
                                   Visibility="{Binding HasExif, Converter={StaticResource BoolToVis}}"/>

                        <!-- GPS coordinates (optional) -->
                        <TextBlock Text="GPS" Style="{StaticResource MetaLabel}"
                                   Visibility="{Binding HasGps, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding GpsText}" Style="{StaticResource MetaValue}"
                                   Visibility="{Binding HasGps, Converter={StaticResource BoolToVis}}"
                                   Cursor="Hand" TextDecorations="Underline"
                                   ToolTip="Open location in Google Maps">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenInMapsCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>

                        <!-- ── AI Description ── -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                    Visibility="{Binding HasAiDescription, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AI DESCRIPTION" Style="{StaticResource SectionHead}" Margin="0"/>
                            <TextBlock Text="{Binding AiModelText}"
                                       FontSize="10"
                                       Foreground="{StaticResource SubtextBrush}"
                                       Opacity="0.65"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasAiModelText, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBox Text="{Binding Current.AiDescription, Mode=OneWay}"
                                 Style="{StaticResource SelectableText}"
                                 FontSize="13"
                                 Margin="0,0,0,12"
                                 Visibility="{Binding HasAiDescription, Converter={StaticResource BoolToVis}}"/>

                        <!-- Description failed indicator -->
                        <StackPanel Visibility="{Binding DescriptionAttemptedButFailed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AI DESCRIPTION" Style="{StaticResource SectionHead}"/>
                            <TextBlock Text="⚠ No description"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#CC6600"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="The vision model returned no result for this photo. This can happen with unusual JPEG encodings, CMYK color profiles, or unsupported RAW formats. Re-analyze to retry."
                                       FontSize="11"
                                       Foreground="{StaticResource SubtextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- ── Tags ── -->
                        <TextBlock Text="TAGS" Style="{StaticResource SectionHead}"
                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Tags}"
                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="3"
                                            Padding="6,3" Margin="0,0,5,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- Remove button: only shown for user-added tags -->
                                            <Button Content="×" FontSize="11" Padding="3,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#FF888888" Cursor="Hand"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveTagCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsAIGenerated,
                                                                 Converter={StaticResource InverseBoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add tag input row -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource SurfaceBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource AccentBrush}"
                                     FontSize="12" Padding="6,4">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="+" Margin="4,0,0,0"
                                    Padding="10,4" FontSize="14"
                                    Style="{StaticResource ActionBtn}"
                                    Command="{Binding AddTagCommand}"/>
                        </Grid>

                        <!-- ── People / Faces ── -->
                        <StackPanel Visibility="{Binding HasFaces, Converter={StaticResource BoolToVis}}">

                            <!-- "Who is in this photo?" prompt — shown on first view -->
                            <Border Visibility="{Binding ShowFacePrompt, Converter={StaticResource BoolToVis}}"
                                    Background="#FF313244" CornerRadius="6" Padding="12,10"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Who is in this photo?"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,0,0,10"/>

                                    <!-- Face strip with name inputs -->
                                    <ItemsControl ItemsSource="{Binding Faces}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="80" Margin="0,0,8,8">
                                                    <!-- Face crop thumbnail — clickable for inline tagging -->
                                                    <Border Width="72" Height="72"
                                                            CornerRadius="4"
                                                            Background="#FF1E1E2E"
                                                            ClipToBounds="True"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonUp="SidebarFaceThumbnail_Click">
                                                        <Image Source="{Binding ThumbnailPath,
                                                                   Converter={StaticResource PathToBitmap}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <!-- Name box with ghost suggestion overlay -->
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="#FF1E1E2E"
                                                                 Foreground="#FFCDD6F4"
                                                                 BorderBrush="#FF45475A"
                                                                 BorderThickness="1"
                                                                 FontSize="11"
                                                                 Padding="4,3"
                                                                 MaxLength="60"
                                                                 ToolTip="Type a name, or leave blank"
                                                                 GotFocus="SidebarNameBox_GotFocus"
                                                                 LostFocus="SidebarNameBox_LostFocus"
                                                                 TextChanged="SidebarNameBox_TextChanged"
                                                                 PreviewKeyDown="SidebarNameBox_PreviewKeyDown"/>
                                                        <!-- Ghost suggestion text (shown when box is empty) -->
                                                        <TextBlock Text="{Binding SuggestedName}"
                                                                   Foreground="#60CDD6F4"
                                                                   FontStyle="Italic"
                                                                   FontSize="11"
                                                                   Padding="5,3"
                                                                   IsHitTestVisible="False"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasSuggestion,
                                                                       Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                    <!-- Accept / reject suggestion buttons -->
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,3,0,0"
                                                                Visibility="{Binding HasSuggestion,
                                                                    Converter={StaticResource BoolToVis}}">
                                                        <Button Width="34" Height="17" Padding="0"
                                                                FontSize="10" Content="✓"
                                                                Foreground="#FF89DCEB"
                                                                Style="{StaticResource ActionBtn}"
                                                                ToolTip="{Binding SuggestedName,
                                                                    StringFormat='Accept: {0}'}"
                                                                Command="{Binding DataContext.AcceptSuggestionCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Width="34" Height="17" Padding="0"
                                                                FontSize="10" Content="✗"
                                                                Foreground="#FFEBA0AC"
                                                                Style="{StaticResource ActionBtn}"
                                                                Margin="4,0,0,0"
                                                                ToolTip="Not this person"
                                                                Command="{Binding DataContext.RejectSuggestionCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Action buttons -->
                                    <StackPanel Margin="0,6,0,0">
                                        <Button Content="Accept all confirmed"
                                                Command="{Binding DataContext.AcceptAllConfirmedCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ActionBtn}"
                                                Padding="12,6" FontSize="12"
                                                HorizontalAlignment="Stretch"
                                                ToolTip="Confirm matched names and accept all AI suggestions"
                                                Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save names"
                                                    Command="{Binding DataContext.SaveFaceNamesCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource ActionBtn}"
                                                    Padding="12,6" FontSize="12"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="Skip"
                                                    Command="{Binding DataContext.SkipFacePromptOnceCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource ActionBtn}"
                                                    Padding="12,6" FontSize="12"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="Never ask"
                                                    Command="{Binding DataContext.SkipFacePromptAlwaysCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Don't ask for this photo again"
                                                    Style="{StaticResource ActionBtn}"
                                                    Padding="12,6" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Static PEOPLE section (always visible once faces are loaded) -->
                            <TextBlock Text="PEOPLE" Style="{StaticResource SectionHead}"
                                       Visibility="{Binding ShowFacePrompt, Converter={StaticResource InverseBoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Faces}"
                                          Visibility="{Binding ShowFacePrompt, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="80" Margin="0,0,8,8">
                                            <Border Width="72" Height="72"
                                                    CornerRadius="4"
                                                    Background="#FF1E1E2E"
                                                    ClipToBounds="True"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="SidebarFaceThumbnail_Click">
                                                <Grid>
                                                    <!-- Person icon placeholder for mention-only entries (no face crop) -->
                                                    <TextBlock Text="👤" FontSize="28"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.4"
                                                               Visibility="{Binding IsManualMention,
                                                                   Converter={StaticResource BoolToVis}}"/>
                                                    <Image Source="{Binding ThumbnailPath,
                                                               Converter={StaticResource PathToBitmap}}"
                                                           Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding NameInput}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SubtextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"
                                                       HorizontalAlignment="Center"
                                                       ToolTip="{Binding NameInput}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom button row — pinned to bottom -->
                <Border Grid.Row="1" Padding="24,12" Background="{StaticResource PaneBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Close  (Esc)"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource ActionBtn}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="💾 Export…"
                                Command="{Binding ExportAsBundleCommand}"
                                Style="{StaticResource ActionBtn}"
                                Padding="12,5"
                                ToolTip="Export this photo as a portable bundle"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Shared autocomplete dropdown for sidebar face name TextBoxes.
             PlacementTarget and IsOpen are set in code-behind. -->
        <Popup x:Name="SidebarDropdown"
           Placement="Bottom"
           StaysOpen="True"
           AllowsTransparency="True">
        <Border Background="#FF313244"
                BorderBrush="#FF45475A" BorderThickness="1,0,1,1"
                MaxHeight="150">
            <ListBox x:Name="SidebarNameList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#FFCDD6F4"
                     IsTabStop="False"
                     MinWidth="160"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="SidebarNameList_MouseUp"
                     PreviewKeyDown="SidebarNameList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#FFCDD6F4"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF45475A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF89B4FA"/>
                                            <Setter Property="Foreground" Value="#FF1E1E2E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Popup>
</Grid>
</Window>
