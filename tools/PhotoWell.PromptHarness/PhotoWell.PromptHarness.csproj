<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhotoWell.PromptHarness</AssemblyName>
    <RootNamespace>PhotoWell.PromptHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy gates.json to output so it's always next to the binary -->
    <Content Include="gates.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
